# Obelisk build configuration — copy to config.env and fill in.
#
#     cp config.env.example config.env
#
# config.env is git-ignored and never committed. Nothing in this repository contains a
# real domain, key ID, or account name; every such value arrives from here. Scripts that
# need a value and cannot find one either omit the field entirely or fail with a message
# naming the variable — they never substitute a plausible-looking fake.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# GitHub owner/repository, e.g. "someuser/obelisk".
# Used for CI badge URLs, release links, and the GitHub Pages repository URL.
# REQUIRED before Phase 10. Not needed to build an ISO.
OBELISK_GITHUB_SLUG=

# Canonical project URL. Appended to the ISO publisher field when set, and omitted
# entirely when unset. Do not invent one to fill the gap.
OBELISK_URL=

# Maintainer identity used in PKGBUILD headers and release metadata.
OBELISK_MAINTAINER=
OBELISK_MAINTAINER_EMAIL=

# ---------------------------------------------------------------------------
# Delayed mirror (decision D2, docs/ARCHITECTURE.md)
# ---------------------------------------------------------------------------

# Arch Linux Archive snapshot date, format YYYY/MM/DD.
#
# This is the mechanism that keeps Obelisk 7-14 days behind Arch. Choose a date at
# least 7 and at most 14 days in the past. CI advances it only after a build and smoke
# test pass on the new date. To fast-track an emergency security fix, move this forward
# and note the reason in the commit message.
#
# Verify a candidate date exists before using it:
#     curl -sfI https://archive.archlinux.org/repos/2026/08/14/core/os/x86_64/core.db
OBELISK_ARCHIVE_DATE=2026/08/14

# ---------------------------------------------------------------------------
# Package repository (Phase 10)
# ---------------------------------------------------------------------------

# Public URL of the published Obelisk pacman repository.
# Left empty during bootstrap: the ISO builds from Arch alone until this exists.
OBELISK_REPO_URL=

# Local repository directory produced by repo/build-packages.sh. When this directory
# contains an obelisk.db, scripts/build-iso.sh adds it to the build-time pacman.conf
# as the LAST repository. When it does not exist, the build proceeds from Arch alone.
# This is what lets the very first ISO be built before anything has been published.
OBELISK_LOCAL_REPO=out/repo

# GPG key ID used to sign packages and the repository database.
# REQUIRED before Phase 10. See docs/KEYRING.md for the rotation schedule.
OBELISK_GPG_KEY_ID=

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------

# Hard ceiling on the produced ISO, in mebibytes. Exceeding it fails the build.
# This is a gate, not a guideline: see docs/ARCHITECTURE.md section 10.
OBELISK_MAX_ISO_MIB=3584

# Set to a fixed UNIX timestamp for reproducible builds. CI sets this from the commit
# date. Leave empty locally to use the current time.
SOURCE_DATE_EPOCH=

# ---------------------------------------------------------------------------
# CI secrets — set these as GitHub repository secrets, NOT here
# ---------------------------------------------------------------------------
#   OBELISK_GPG_PRIVATE_KEY     ASCII-armoured private key for signing releases
#   OBELISK_GPG_PASSPHRASE      passphrase for the above
# config.env is for local values only. Never put a private key in it.
