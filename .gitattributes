# Obelisk line-ending policy.
#
# This is the first file in the repository and the most important one for a project
# developed on Windows and built on Linux. A single CRLF inside a shell script makes
# the kernel fail to find the interpreter and produces "bad interpreter: No such file
# or directory", which is one of the least obvious error messages in Unix.
#
# scripts/check-line-endings.sh enforces this in CI. Do not weaken either file.

# Default: normalise everything Git detects as text to LF in the working tree.
* text=auto eol=lf

# Explicit LF for everything that is executed, sourced, or parsed on Linux.
# Listed explicitly so the rule survives Git's text detection being wrong.
*.sh        text eol=lf
*.bash      text eol=lf
*.install   text eol=lf
PKGBUILD    text eol=lf
*.hook      text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.socket    text eol=lf
*.mount     text eol=lf
*.target    text eol=lf
*.preset    text eol=lf
*.rules     text eol=lf
*.desktop   text eol=lf
*.py        text eol=lf
*.pl        text eol=lf
*.qml       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.xml       text eol=lf
*.ts        text eol=lf
*.qss       text eol=lf
*.css       text eol=lf
*.svg       text eol=lf
*.policy    text eol=lf
*.pam       text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
LICENSE        text eol=lf

# Files with no extension that are still shell or config.
mkinitcpio.conf   text eol=lf
profiledef.sh     text eol=lf
packages.x86_64   text eol=lf
pacman.conf       text eol=lf

# Binary: never touched, never normalised, never diffed as text.
*.png   binary
